{
  "permissions": {
    "allow": [
      "WebSearch",
      "Skill(project-management)",
      "Skill(update-config)",
      "Bash(claude)",
      "Skill(quality-auditor)",
      "mcp__wide-researcher__wr_find",
      "mcp__wide-researcher__wr_impact",
      "mcp__wide-researcher__wr_file",
      "Bash(rm -rf /var/www/fercup.com/assets/*)",
      "Bash(cp -rf /var/www/grweb/ferweb/dist/* /var/www/fercup.com/)",
      "Read(//var/www/fercup.com/**)",
      "Bash(rm -rf /var/www/backoffice/*)",
      "Bash(cp -r /var/www/grweb/backoffice/dist/* /var/www/backoffice/)",
      "Read(//var/www/backoffice/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"OBLIGATORIO — PASO CERO: Antes de procesar CUALQUIER prompt del usuario, DEBES lanzar el agente prompt-enhancer con subagent_type=prompt-enhancer para que use la skill prompt-architect y mejore el prompt. Solo DESPUES de recibir el prompt mejorado, pásalo al project-manager con skill project-management. Esto es INNEGOCIABLE según CLAUDE.md. NO puedes procesar el prompt directamente sin pasar por prompt-enhancer primero. NO puedes saltarte este paso bajo ninguna circunstancia.\"}}'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/var/www/grweb/.wide-researcher/hooks/wide_research_hook.py\"",
            "timeout": 30,
            "statusMessage": "Mapping impact radius (qdrant + MiniLM-L6)…"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "bunnycdn": {
      "command": "node",
      "args": [
        "/var/www/grweb/.claude/mcp/bunnycdn/server.js"
      ],
      "env": {
        "BUNNY_API_KEY": "c6a0858c-9208-479b-8b5d-14ec8f2312b5",
        "BUNNY_STORAGE_KEY": "0d8cd3df-400c-483c-878e-061dca7bb281",
        "BUNNY_STORAGE_ZONE": "jaimedigitalstudio",
        "BUNNY_PULL_ZONE_URL": "https://jaimedigitalstudio.b-cdn.net"
      }
    }
  }
}
