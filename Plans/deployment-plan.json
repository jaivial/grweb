  "nginx_config_template": {
    "file": "/etc/nginx/sites-available/grcup.jaimedigitalstudio.com",
    "upstream_backend": "http://127.0.0.1:5006",
    "static_root": "/var/www/grweb/dist",
    "key_features": {
      "http3_quic": true,
      "http2": true,
      "tls_versions": ["TLSv1.2", "TLSv1.3"],
      "ocsp_stapling": true,
      "gzip": true,
      "brotli": "optional (requires nginx module)",
      "security_headers": [
        "Strict-Transport-Security: max-age=31536000; includeSubDomains; preload",
        "X-Frame-Options: SAMEORIGIN",
        "X-Content-Type-Options: nosniff",
        "X-XSS-Protection: 1; mode=block",
        "Referrer-Policy: strict-origin-when-cross-origin",
        "Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
      ],
      "caching": {
        "static_assets": "1 year, immutable",
        "html": "no-cache"
      },
      "rate_limiting": {
        "global_connection": "10 per IP",
        "api_requests": "5 per IP burst 10"
      }
    },
    "locations": {
      "/": {
        "type": "spa_fallback",
        "try_files": "$uri $uri/ /index.html"
      },
      "/api/": {
        "type": "proxy",
        "target": "http://127.0.0.1:5006",
        "websocket": true
      },
      "/api/webhooks/stripe": {
        "type": "proxy",
        "target": "http://127.0.0.1:5006",
        "note": "No rate limiting for webhooks"
      },
      "~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|map|json|avif|webm)$": {
        "type": "static",
        "cache": "1 year immutable"
      }
    }
  },
  "docker_compose_template": {
    "version": "3.8",
    "services": {
      "api": {
        "build": "./backend/GrCup.Api",
        "container_name": "grcup-api",
        "restart": "unless-stopped",
        "ports": ["5006:5006"],
        "environment": {
          "ASPNETCORE_URLS": "http://+:5006",
          "ASPNETCORE_ENVIRONMENT": "Production"
        },
        "env_file": ["./backend/GrCup.Api/.env"],
        "depends_on": ["mysql"],
        "networks": ["grcup-network"]
      },
      "mysql": {
        "image": "mysql:8.0",
        "container_name": "grcup-mysql",
        "restart": "unless-stopped",
        "ports": ["3308:3306"],
        "environment": {
          "MYSQL_ROOT_PASSWORD": "SECURE_PASSWORD_HERE",
          "MYSQL_DATABASE": "grcup"
        },
        "volumes": ["grcup-mysql-data:/var/lib/mysql"],
        "networks": ["grcup-network"],
        "command": ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci"]
      }
    },
    "networks": {
      "grcup-network": {
        "driver": "bridge"
      }
    },
    "volumes": {
      "grcup-mysql-data": {}
    }
  },
  "dockerfile_template": {
    "base_image": "mcr.microsoft.com/dotnet/aspnet:8.0",
    "sdk_image": "mcr.microsoft.com/dotnet/sdk:8.0",
    "workdir": "/app",
    "expose_port": 5006,
    "optimizations": [
