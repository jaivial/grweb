      "Restore previous nginx config: rm /etc/nginx/sites-enabled/grcup.jaimedigitalstudio.com",
      "nginx -s reload",
      "Restore database from backup if needed"
    ]
  },
  "monitoring": {
    "logs": {
      "docker_logs": "docker-compose logs -f",
      "nginx_access": "/var/log/nginx/grcup.jaimedigitalstudio.com.access.log",
      "nginx_error": "/var/log/nginx/grcup.jaimedigitalstudio.com.error.log"
    },
    "health_checks": {
      "api": "curl -f https://grcup.jaimedigitalstudio.com/api/health || exit 1",
      "database": "docker exec grcup-mysql mysqladmin ping -h localhost"
    }
  },
