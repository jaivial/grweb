# Stripe keys are stored in the StripeConfig database table, NOT in env files.
# Configure via backoffice Stripe settings per competition.

# JWT Configuration
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Database
CONNECTION_STRING=Server=localhost;Database=grcup;User=root;Password=yourpassword;

# BunnyCDN Storage Zone (FTP)
BUNNYCDN_HOSTNAME=storage.bunnycdn.com
BUNNYCDN_USERNAME=jaimedigitalstudio
BUNNYCDN_PASSWORD=your-bunnycdn-storage-password
BUNNYCDN_READONLY_PASSWORD=your-bunnycdn-readonly-password
