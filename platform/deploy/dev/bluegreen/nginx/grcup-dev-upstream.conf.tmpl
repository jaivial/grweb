# GRS Cup (dev en jaime-desktop). Destinos vivos de cada puerta: lo reescribe lib.sh (render_upstream) en cada
# redeploy y rollback. No editar a mano: el archivo instalado lo genera el script.
map $http_upgrade $grcup_dev_conn { default upgrade; '' ''; }

upstream grcup_web {
    server 127.0.0.1:@WEB_PORT@;
}

upstream grcup_api {
    server 127.0.0.1:@API_PORT@;
    keepalive 16;
}

# Comprobación por contenido de la recarga (lib.sh, nginx_reload_ok): responde los colores que esta config lleva.
server {
    listen 127.0.0.1:18398;
    server_name _;
    location = /__color {
        default_type text/plain;
        return 200 "web=@WEB_COLOR@ api=@API_COLOR@\n";
    }
    location / { return 404; }
}
